{
  "name": "zemdomu-mcp",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "description": "Read-only semantic HTML and accessibility analysis for MCP clients.",
  "bin": {
    "zemdomu-mcp": "./out/src/cli.js"
  },
  "files": [
    "out/src",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node out/src/cli.js",
    "prepack": "npm run build",
    "test": "npm run build && node --test out/tests/*.test.js",
    "desktop:build": "node desktop/build.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "typescript": "5.9.3",
    "zemdomu": "2.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.9.1"
  },
  "mcpName": "io.github.Zemdomu/zemdomu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zemdomu/ZemDomu-mcp.git"
  },
  "homepage": "https://zemdomu.dev/docs/installation/mcp",
  "bugs": {
    "url": "https://github.com/Zemdomu/ZemDomu-mcp/issues"
  },
  "keywords": [
    "zemdomu",
    "mcp",
    "accessibility",
    "semantic-html"
  ]
}
